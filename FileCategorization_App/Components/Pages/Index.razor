@page "/"
@page "/home"
@implements IAsyncDisposable

<RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
    <RadzenButton Click="RefreshFilesAndCategories" Icon="autorenew" ButtonStyle="ButtonStyle.Dark"
                  Size="ButtonSize.Large" IsBusy=@busyRefresh
                  BusyText="Wait ..."/>
    <RadzenButton Click="TrainModel" Icon="psychology" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Large"
                  IsBusy=@busyTrain
                  BusyText="Training ..."/>

    @if (filetomove)
    {
        <RadzenButton Click="moveFiles" Icon="drive_file_move" ButtonStyle="ButtonStyle.Secondary"
                      Size="ButtonSize.Large" IsBusy=@busy
                      BusyText="Moving ..."/>
    }
    else
    {
        <RadzenButton Click="moveFiles" Icon="drive_file_move" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Large"
                      IsBusy=@busy
                      BusyText="Moving ..."/>
    }


</RadzenRow>
<hr/>
<RadzenText TextStyle="TextStyle.Caption">
    Files in Grid: @(fileDetail?.Count() ?? 0) | 
    SignalR: @(_notificationService.IsConnected ? "Connected" : "Disconnected") | 
    RefreshBusy: @busyRefresh
</RadzenText>
<hr/>

<RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Left">
    @if (viewaddcategory)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                     JustifyContent=JustifyContent.SpaceBetween
                     Wrap="FlexWrap.Wrap" Gap="1rem">
            <RadzenTextBox @bind-Value="newCat" Placeholder="New Category" Name="Category"/>
            <RadzenButton Click="NewCatCancel" ButtonStyle="ButtonStyle.Dark" Icon="cancel"></RadzenButton>
            <RadzenButton Click="AddNewCat" ButtonStyle="ButtonStyle.Info" Icon="save"></RadzenButton>
        </RadzenStack>
    }
    else
    {
        <RadzenButton Variant="Variant.Text" Click="ViewCategory" Icon="add" ButtonStyle="ButtonStyle.Primary"
                      Size="ButtonSize.Medium" Text="New Category"/>
    }
</RadzenRow>

<RadzenRow>
    <RadzenLabel>@testo</RadzenLabel>
</RadzenRow>

<RadzenRow>

    @if (fileDetail == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <RadzenDataGrid AllowFiltering="false" AllowColumnResize="false" AllowAlternatingRows="true"
                        Density="Density.Compact"
                        FilterMode="FilterMode.Advanced" AllowSorting="true"
                        AllowVirtualization="true"
                        Data="@fileDetail" TItem="FilesDetailDto">

            @*                PageSize="9" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true"*@
            <Columns>


                <RadzenDataGridColumn TItem="FilesDetailDto" Property="Name" Title="Name" Width="50%"
                                      Filterable="false">
                    <Template Context="name">
                        <p style="white-space:normal">@name.Name (@_utilityService.FileSizeFormatted(name.FileSize))</p>
                    </Template>
                </RadzenDataGridColumn>


                <RadzenDataGridColumn Context="category" TItem="FilesDetailDto" Property="FileCategory" Title="Category"
                                      Width="40%">
                    <Template Context="category">
                        <RadzenDropDown AllowClear="true"
                                        TValue="string" Class="w-99" Placeholder="Select a Category"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        AllowFiltering="false"
                                        Data=@categories @bind-Value="@category.FileCategory"/>
                    </Template>

                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="FilesDetailDto" Context="detail" Title="Actions" Filterable="false"
                                      Sortable="false"
                                      TextAlign="TextAlign.Center" Width="20%">
                    <Template Context="detail">

                        <RadzenSwitch @bind-Value=@detail.IsToCategorize
                                      Change=@(args => OnSwitchChange(args, "Switch"))/>

                    </Template>
                </RadzenDataGridColumn>

            </Columns>
        </RadzenDataGrid>
    }

</RadzenRow>



@using FileCategorization_App.Components.Interface
@using FileCategorization_Shared.DTOs.FileManagement
@code {
    [Inject] public IServiceApi _controller { get; set; }
    [Inject] public IUtilityServices _utilityService { get; set; }
    [Inject] public IUnifiedNotificationService _notificationService { get; set; }
    [Inject] public ISignalRService _signalRService { get; set; }
    [Inject] public IGlobalConsoleService _consoleService { get; set; }
    
    private IEnumerable<FilesDetailDto> fileDetail;
    private FilesDetailDto file;
    protected List<string> categories;
    private string testo;
    private string newCat;
    bool viewaddcategory = false;
    bool filetomove;
    bool busy;
    bool busyRefresh;
    bool busyTrain;
    List<int> fileMoved = new List<int>();


    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Setup unified notification service handlers
            SetupNotificationHandlers();
            
            // Register callback methods with SignalRService for direct method calling
            _signalRService.OnRefreshJobCompleted = OnRefreshJobCompleted;
            _signalRService.OnRefreshJobFailed = OnRefreshJobFailed;
            
            var statusMessage = $"SignalR - Connection status: {(_notificationService.IsConnected ? "Connected" : "Disconnected")}";
            if (_notificationService.IsConnected && !string.IsNullOrEmpty(_notificationService.ConnectionId))
            {
                statusMessage += $" - ID: {_notificationService.ConnectionId}";
            }
            _consoleService.AddTimestampedMessage(statusMessage);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting up notifications: {ex.Message}");
            _consoleService.AddTimestampedMessage($"Error setting up notifications: {ex.Message}");
        }

        // Load initial data
        await RefreshFilesAndCategories();
    }

    private void SetupNotificationHandlers()
    {
        // Subscribe to high-level business events using the unified service
        _notificationService.SubscribeToFileOperations(
            onFileMoved: (fileId) =>
            {
                // File successfully moved - remove from UI list
                Log.Information($"File {fileId} moved successfully, removing from UI");
                fileDetail = fileDetail.Where(x => x.Id != fileId).ToList();
                notify(0);
                InvokeAsync(StateHasChanged);
            },
            onJobCompleted: (message) =>
            {
                // Job completed - but NOT refresh jobs (handled by specific RefreshFilesNotificationReceived)
                Log.Information($"Job completed: {message}");
                
                // Skip refresh jobs - they have dedicated handler
                if (message.ToLower().Contains("refresh"))
                {
                    Log.Information("Refresh job completion - handled by RefreshFilesNotificationReceived handler");
                    return;
                }
                
                // Handle other job types (training, move files, etc.)
                _consoleService.AddTimestampedMessage(message);
                fileMoved = new List<int>();
                busy = false;
                busyTrain = false;
                
                InvokeAsync(async () =>
                {
                    await refreshFileList();
                    StateHasChanged();
                });
            }
        );

        // Subscribe to connection status changes
        _notificationService.ConnectionStatusChanged += (statusMessage) =>
        {
            _consoleService.AddTimestampedMessage($"SignalR - {statusMessage}");
            InvokeAsync(StateHasChanged);
        };

        // Subscribe to model training completion specifically
        _notificationService.ModelTrainingCompleted += (message) =>
        {
            Log.Information($"Model training completed: {message}");
            _consoleService.AddTimestampedMessage($"Training completed: {message}");
            busyTrain = false;
            InvokeAsync(StateHasChanged);
        };

        // Subscribe to refresh progress updates - DISABLED: SignalRService now handles this directly
        // _notificationService.RefreshProgress += (progressMessage) =>
        // {
        //     _consoleService.AddTimestampedMessage(progressMessage);
        //     InvokeAsync(StateHasChanged);
        // };

        // SignalR refresh completion will be handled directly by SignalRService

        // Subscribe to errors
        _notificationService.ErrorOccurred += (errorMessage) =>
        {
            Log.Error($"SignalR Error: {errorMessage}");
            _consoleService.AddTimestampedMessage($"Error: {errorMessage}");
            busy = false;
            busyRefresh = false;
            busyTrain = false;
            InvokeAsync(StateHasChanged);
        };
    }

    public async ValueTask DisposeAsync()
    {
        // Unsubscribe from unified service events
        _notificationService.UnsubscribeFromFileOperations();
        
        // Clean up SignalR callback references
        if (_signalRService != null)
        {
            _signalRService.OnRefreshJobCompleted = null;
            _signalRService.OnRefreshJobFailed = null;
        }
        
        await ValueTask.CompletedTask;
    }

    /// <summary>
    /// Refresh the file list and categories from the API v2 with job tracking
    /// </summary>
    private async Task RefreshFilesAndCategories()
    {
        busyRefresh = true;
        _consoleService.AddTimestampedMessage("Refresh data: starting background job...");

        Log.Information("Starting RefreshFilesAndCategories background job");
        Console.WriteLine("RefreshFilesAndCategories: Starting background job");

        var result = await _controller.RefreshCategoryAsync(); //api/v2/actions/refresh-files
        
        if (result.IsSuccess)
        {
            // Log job start with job ID
            var jobMessage = result.Value ?? "Background job started";
            Log.Information($"RefreshFilesAndCategories job started successfully: {jobMessage}");
            Console.WriteLine($"RefreshFilesAndCategories: {jobMessage}");
            
            _consoleService.AddTimestampedMessage($"Job started: {jobMessage}");
            
            // Don't call refreshFileList immediately - wait for SignalR notification
            // The refreshFilesNotifications handler will call refreshFileList when job completes
        }
        else
        {
            // Log job start failure
            var errorMessage = $"Failed to start refresh job: {result.Error}";
            Log.Error(errorMessage);
            Console.WriteLine($"RefreshFilesAndCategories ERROR: {errorMessage}");
            
            _consoleService.AddTimestampedMessage(errorMessage);
            busyRefresh = false;
        }

        // Note: busyRefresh will be set to false by SignalR notification handler when job completes
    }


    private async Task refreshFileList()
    {
        Log.Information("🔄 refreshFileList started - calling GetFilesAsync");
        Console.WriteLine("refreshFileList started - calling GetFilesAsync");
        
        try
        {
            var result = await _controller.GetFilesAsync(); //api/v2/files/filtered/3
            
            if (result.IsSuccess)
            {
                var fileCount = result.Value?.Count() ?? 0;
                Log.Information($"📁 GetFilesAsync SUCCESS - received {fileCount} files");
                Console.WriteLine($"GetFilesAsync SUCCESS - received {fileCount} files");
                
                var previousCount = fileDetail?.Count() ?? 0;
                fileDetail = result.Value ?? new List<FilesDetailDto>();
                var newCount = fileDetail.Count();
                
                Log.Information($"📊 fileDetail updated: {previousCount} → {newCount} files");
                Console.WriteLine($"📊 fileDetail updated: {previousCount} → {newCount} files");
                
                Log.Information("📂 Calling RefreshCategoryList...");
                Console.WriteLine("Calling RefreshCategoryList...");
                await RefreshCategoryList();
                
                Log.Information($"✅ refreshFileList completed successfully - fileDetail.Count = {fileDetail.Count()}");
                Console.WriteLine($"refreshFileList completed successfully - fileDetail.Count = {fileDetail.Count()}");
                
                // Update file count indicator
                notify(0);
                
                // Force UI update to ensure grid refreshes
                InvokeAsync(StateHasChanged);
            }
            else
            {
                var errorMsg = $"❌ GetFilesAsync failed: {result.Error}";
                Log.Error(errorMsg);
                Console.WriteLine(errorMsg);
                
                // Set empty list to clear grid
                fileDetail = new List<FilesDetailDto>();
                
                // This error should propagate to the calling handler
                throw new Exception($"Failed to load files: {result.Error}");
            }
        }
        catch (Exception ex)
        {
            var errorMsg = $"❌ refreshFileList exception: {ex.Message}";
            Log.Error(errorMsg);
            Console.WriteLine(errorMsg);
            
            // Set empty list and re-throw to be handled by calling SignalR handler
            fileDetail = new List<FilesDetailDto>();
            InvokeAsync(StateHasChanged);
            
            throw; // Re-throw to be handled by SignalR completion handler
        }
    }

    private async Task TrainModel()
    {
        _consoleService.AddTimestampedMessage("start train model...");
        busyTrain = true;

        var result = await _controller.TrainModelAsync(); //api/v2/actions/train-model
        //TODO is a job? proceed with signalr notifications
        if (result.IsSuccess)
        {
            _consoleService.AddTimestampedMessage(result.Value ?? "Model training completed");
        }
        else
        {
            _consoleService.AddTimestampedMessage($"Training failed: {result.Error}");
        }

        busyTrain = false;
    }


    private async Task moveFiles()
    {
        _consoleService.AddTimestampedMessage("start moving files...");
        busy = true;

        var filesToMove = fileDetail.Where(f => f.IsToCategorize).ToList();
        var result = await _controller.MoveFilesAsync(filesToMove);

        if (result.IsSuccess)
        {
            _consoleService.AddTimestampedMessage(result.Value ?? "Files move operation completed");
        }
        else
        {
            _consoleService.AddTimestampedMessage($"Move files failed: {result.Error}");
            busy = false;
            InvokeAsync(StateHasChanged);
        }
    }


    protected async Task RefreshCategoryList()
    {
        Log.Information("🏷️ RefreshCategoryList started - calling GetCategoriesAsync");
        Console.WriteLine("RefreshCategoryList started - calling GetCategoriesAsync");
        
        var result = await _controller.GetCategoriesAsync(); //api/v2/categories
        if (result.IsSuccess)
        {
            var categoryCount = result.Value?.Count ?? 0;
            categories = result.Value ?? new List<string>();
            
            Log.Information($"🏷️ GetCategoriesAsync SUCCESS - received {categoryCount} categories");
            Console.WriteLine($"GetCategoriesAsync SUCCESS - received {categoryCount} categories");
        }
        else
        {
            categories = new List<string>();
            
            var errorMsg = $"❌ Error loading categories: {result.Error}";
            Log.Error(errorMsg);
            Console.WriteLine(errorMsg);
            
            // DON'T overwrite the main log here - let the refresh completion message stay
            // log = $"Error loading categories: {result.Error}";  // REMOVED
            
            // Instead, this should be handled as an exception since categories are critical
            throw new Exception($"Failed to load categories: {result.Error}");
        }

        InvokeAsync(StateHasChanged);
        
        Log.Information("✅ RefreshCategoryList completed successfully");
        Console.WriteLine("RefreshCategoryList completed successfully");
    }



    /// <summary>
    /// Public method called by SignalRService when refresh job completes
    /// </summary>
    public async Task OnRefreshJobCompleted(string message)
    {
        Log.Information($"🎉 OnRefreshJobCompleted called with message: {message}");
        Console.WriteLine($"OnRefreshJobCompleted called: {message}");
        
        await InvokeAsync(async () =>
        {
            try
            {
                // Reset busy state and update UI
                busyRefresh = false;
                StateHasChanged();
                
                // Execute refresh file list
                Log.Information("⚡ Executing refreshFileList from SignalRService callback...");
                Console.WriteLine("Executing refreshFileList from SignalRService callback...");
                
                await refreshFileList();
                
                // Don't add message to console here - already handled by SignalRService with proper formatting
                Log.Information($"✅ OnRefreshJobCompleted - RefreshFileList executed successfully");
                Console.WriteLine($"OnRefreshJobCompleted - RefreshFileList executed successfully");
                
                StateHasChanged();
            }
            catch (Exception ex)
            {
                var errorMsg = $"❌ OnRefreshJobCompleted failed: {ex.Message}";
                Log.Error(errorMsg);
                Console.WriteLine(errorMsg);
                
                busyRefresh = false;
                _consoleService.AddTimestampedMessage($"Refresh error: {ex.Message}");
                StateHasChanged();
            }
        });
    }

    /// <summary>
    /// Public method called by SignalRService when refresh job fails
    /// </summary>
    public void OnRefreshJobFailed(string message)
    {
        Log.Error($"❌ OnRefreshJobFailed called with message: {message}");
        Console.WriteLine($"OnRefreshJobFailed called: {message}");
        
        InvokeAsync(() =>
        {
            busyRefresh = false;
            _consoleService.AddTimestampedMessage($"Refresh failed: {message}");
            StateHasChanged();
        });
    }

    private void notify(int num)
    {
        testo = $"Files to move: {fileDetail.Where(x => x.IsToCategorize).Count() - num}";
    }

    private bool AreThereFileToMove()
    {
        if (fileDetail.Where(x => x.IsToCategorize).Count() > 0)
        {
            return true;
        }

        return false;
    }

    void OnSwitchChange(bool? value, string name)
    {
        notify(0);
        filetomove = AreThereFileToMove();
    }

    private void ViewCategory()
    {
        viewaddcategory = true;
    }

    private void NewCatCancel()
    {
        viewaddcategory = false;
        newCat = string.Empty;
    }


    private void AddNewCat()
    {
        if (!string.IsNullOrEmpty(newCat))
        {
            categories.Add(newCat);
            _consoleService.AddTimestampedMessage($"Added new category {newCat}");
            viewaddcategory = false;
            newCat = string.Empty;
        }
        else
        {
            _consoleService.AddTimestampedMessage($"ERROR: new category {newCat} NOT added");
        }
    }

}
